# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=fleet.app.metrics
KAFKA_CLIENT_ID=fleet-copilot-scanner
# Optional auth (leave empty for PLAINTEXT)
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_LINGER_MS=50
KAFKA_BATCH_SIZE=65536
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_FLUSH_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Scan
# ---------------------------------------------------------------------------
SCAN_INTERVAL_SECONDS=180
SCAN_CONCURRENCY=64
NAMESPACE_ALLOW=
NAMESPACE_DENY=kube-system,kube-public,kube-node-lease
REQUIRE_OWNER=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Prometheus
# ---------------------------------------------------------------------------
PROMETHEUS_URL=
PROMETHEUS_TIMEOUT_SECONDS=20
PROMETHEUS_METRIC_QUERIES_FILE=

# ---------------------------------------------------------------------------
# Clusters (JSON list). Either CLUSTERS or CLUSTERS_FILE is required unless
# MOCK_MODE=true. kubeconfig/context may be omitted to use the in-cluster
# service account. prometheus_url falls back to PROMETHEUS_URL.
# ---------------------------------------------------------------------------
MOCK_MODE=false
CLUSTERS=
# CLUSTERS_FILE=/etc/fleet-copilot/clusters.yaml
